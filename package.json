{
  "name": "agent-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent Studio — 本地运行的跨 Agent 协作平台",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/build-maintenance-platform.mjs",
    "prestart": "npm run build:web",
    "start": "node src/server/index.ts",
    "dev:server": "node --watch src/server/index.ts",
    "dev:web": "vite --config src/web/vite.config.ts",
    "build": "npm run build:web",
    "build:web": "vite build --config src/web/vite.config.ts",
    "e2e": "node scripts/e2e-phase1.mjs",
    "e2e:tasks": "node scripts/e2e-tasks.mjs",
    "e2e:memory": "node scripts/e2e-memory.mjs",
    "db:migrate": "node scripts/migrate-data.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:ci:macos:1of2": "node --test --test-shard=1/2 \"tests/**/*.test.ts\"",
    "test:ci:macos:2of2": "node --test --test-shard=2/2 \"tests/**/*.test.ts\"",
    "test:ci:linux": "node --test --test-concurrency=4 \"tests/**/*.test.ts\"",
    "test:ci:linux:1of16": "node --test --test-concurrency=1 --test-shard=1/16 \"tests/**/*.test.ts\"",
    "test:ci:linux:2of16": "node --test --test-concurrency=1 --test-shard=2/16 \"tests/**/*.test.ts\"",
    "test:ci:linux:3of16": "node --test --test-concurrency=1 --test-shard=3/16 \"tests/**/*.test.ts\"",
    "test:ci:linux:4of16": "node --test --test-concurrency=1 --test-shard=4/16 \"tests/**/*.test.ts\"",
    "test:ci:linux:5of16": "node --test --test-concurrency=1 --test-shard=5/16 \"tests/**/*.test.ts\"",
    "test:ci:linux:6of16": "node --test --test-concurrency=1 --test-shard=6/16 \"tests/**/*.test.ts\"",
    "test:ci:linux:7of16": "node --test --test-concurrency=1 --test-shard=7/16 \"tests/**/*.test.ts\"",
    "test:ci:linux:8of16": "node --test --test-concurrency=1 --test-shard=8/16 \"tests/**/*.test.ts\"",
    "test:ci:linux:9of16": "node --test --test-concurrency=1 --test-shard=9/16 \"tests/**/*.test.ts\"",
    "test:ci:linux:10of16": "node --test --test-concurrency=1 --test-shard=10/16 \"tests/**/*.test.ts\"",
    "test:ci:linux:11of16": "node --test --test-concurrency=1 --test-shard=11/16 \"tests/**/*.test.ts\"",
    "test:ci:linux:12of16": "node --test --test-concurrency=1 --test-shard=12/16 \"tests/**/*.test.ts\"",
    "test:ci:linux:13of16": "node --test --test-concurrency=1 --test-shard=13/16 \"tests/**/*.test.ts\"",
    "test:ci:linux:14of16": "node --test --test-concurrency=1 --test-shard=14/16 \"tests/**/*.test.ts\"",
    "test:ci:linux:15of16": "node --test --test-concurrency=1 --test-shard=15/16 \"tests/**/*.test.ts\"",
    "test:ci:linux:16of16": "node --test --test-concurrency=1 --test-shard=16/16 \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p src/web/tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "pg": "^8.23.1",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "ws": "^8.22.0",
    "yaml": "2.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vue-tsc": "^3.3.13"
  }
}
