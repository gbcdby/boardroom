    {"id": "R3", "statement": "outcome_unknown 后状态保持 assigned", "properties": ["UnknownStaysAssigned"]},
    {"id": "R4", "statement": "旧代际观察不能改写当前状态或产生 Reply", "properties": ["NoStaleHandled"]}
